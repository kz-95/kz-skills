      "seed": 599443838,
      "version": 133,
      "versionNonce": 708258814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789563478401,
      "link": null,
      "locked": false,
      "text": "WHY IT VARIED  (the half that matters)\n  BE +40%      T-12 sized M, behaved XL\n               → re-sized, 3 siblings re-sized too\n  rework 31k   D-003 changed mid-session\n               → avoidable, not a velocity problem\n  packs        avg 8.2k in · 31% never referenced\n\nTRIED THIS SESSION\n  ✓ trim packs to Index + direct deps    −14% input\n  ✗ drop CR-Cyrus a tier       2 misses, reverted",
      "originalText": "WHY IT VARIED  (the half that matters)\n  BE +40%      T-12 sized M, behaved XL\n               → re-sized, 3 siblings re-sized too\n  rework 31k   D-003 changed mid-session\n               → avoidable, not a velocity problem\n  packs        avg 8.2k in · 31% never referenced\n\nTRIED THIS SESSION\n  ✓ trim packs to Index + direct deps    −14% input\n  ✗ drop CR-Cyrus a tier       2 misses, reverted",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bOP",
