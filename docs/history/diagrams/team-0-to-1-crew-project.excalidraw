      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "rd67829ERYRvLW1sE4pWU",
      "type": "text",
      "x": -2120.7047174754725,
      "y": -12160.156535228163,
      "width": 411.6,
      "height": 243.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 786491838,
      "version": 133,
      "versionNonce": 481098814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789563478401,
      "link": null,
      "locked": false,
      "text": "FOUR LEVERS  (best payoff first)\n  1 context pack size   biggest input lever\n  2 tier placement      push down till it breaks\n  3 task granularity    fixes overrun AND rework\n  4 rework rate         pure waste, chase to zero\n\nGUARDRAIL — every cost metric needs a quality\nmetric beside it. Optimise tokens-per-point alone\nand ⚙ will starve agents of context and make\neverything cheaper and worse. Watch CR rejection\nrate + rework % or the loop eats the project.\n\n1 session = a signal.  3 sessions = evidence.",
      "originalText": "FOUR LEVERS  (best payoff first)\n  1 context pack size   biggest input lever\n  2 tier placement      push down till it breaks\n  3 task granularity    fixes overrun AND rework\n  4 rework rate         pure waste, chase to zero\n\nGUARDRAIL — every cost metric needs a quality\nmetric beside it. Optimise tokens-per-point alone\nand ⚙ will starve agents of context and make\neverything cheaper and worse. Watch CR rejection\nrate + rework % or the loop eats the project.\n\n1 session = a signal.  3 sessions = evidence.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
